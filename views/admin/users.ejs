<h1 class="page-title"><%= t('allUsers') %></h1>
<%- include('_tabs', { tab: 'users' }) %>
<table class="data">
  <thead><tr><th><%= t('name') %></th><th><%= t('phone') %></th><th><%= t('role') %></th></tr></thead>
  <tbody>
  <% users.forEach(function(u){ %>
    <tr><td data-l="<%= t('name') %>"><a href="/admin/users/<%= u.id %>" style="color:var(--green);font-weight:700"><%= u.name %></a></td><td data-l="<%= t('phone') %>"><%= u.phone %></td><td data-l="<%= t('role') %>"><span class="pill <%= u.role==='admin'?'bad':(u.role==='company'?'warn':'ok') %>"><%= u.role %></span></td></tr>
  <% }) %>
  </tbody>
</table>
