<h1 class="page-title"><%= t('paymentReceipts') %> · telebirr</h1>
<%- include('_tabs', { tab: 'pay' }) %>
<% if (!payments.length) { %><div class="empty">—</div><% } %>
<% payments.forEach(function(p){ %>
  <div class="job-card">
    <div style="display:flex;gap:12px;align-items:center">
      <% if (p.receipt_path) { %><a href="<%= p.receipt_path %>" target="_blank"><img class="receipt-thumb" src="<%= p.receipt_path %>" alt="receipt"></a><% } %>
      <div>
        <h3 style="margin:0"><%= p.title %></h3>
        <div class="meta-line"><span><a href="/admin/users/<%= p.company_user_id %>" style="color:var(--green);font-weight:700"><%= p.company_name %></a></span></div>
      </div>
    </div>
    <div style="margin:8px 0"><a href="/admin/users/<%= p.company_user_id %>" style="color:var(--green);font-weight:700"><%= t('viewProfile') %> →</a></div>
    <div class="row-actions" style="margin-top:10px">
      <form method="post" action="/admin/payments/<%= p.id %>/approve"><button class="btn btn-green btn-sm" type="submit">✓ <%= t('approve') %></button></form>
      <form method="post" action="/admin/payments/<%= p.id %>/reject"><button class="btn btn-red btn-sm" type="submit">✕ <%= t('reject') %></button></form>
    </div>
  </div>
<% }) %>
