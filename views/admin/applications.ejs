<h1 class="page-title"><%= t('applications') %></h1>
<%- include('_tabs', { tab: 'apps' }) %>
<% if (!apps.length) { %><div class="empty">—</div><% } %>
<% apps.forEach(function(a){ %>
  <div class="job-card">
    <h3><%= a.job_title %></h3>
    <div class="co-line"><span><%= a.company_name %></span></div>
    <div class="meta-line">
      <span><b><%= a.freelancer_name %></b> · <%= a.freelancer_phone %></span>
      <span class="pill <%= a.status==='accepted'?'ok':(a.status==='rejected'?'bad':'wait') %>"><%= t(a.status) %></span>
    </div>
    <% if (a.proposal) { %><p><b><%= t('proposal') %>:</b> <%= a.proposal %></p><% } %>
    <div class="field"><label><%= t('viewDocs') %></label>
      <% (docs[a.id]||[]).forEach(function(d){ %>
        <div class="doc-row">
          <div class="doc-ico"><%- icon('file') %></div>
          <div class="grow"><b><%= d.doc_name %></b></div>
          <% if (d.file_path) { %><a class="btn btn-amber btn-sm" href="<%= d.file_path %>" target="_blank" download><%- icon('download') %> <%= t('download') %></a><% } else { %><span class="pill wait">—</span><% } %>
        </div>
      <% }) %>
    </div>
    <div class="meta-line"><span class="sub"><%= new Date(a.created_at).toLocaleString() %></span></div>
  </div>
<% }) %>
