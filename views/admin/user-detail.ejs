<h1 class="page-title"><%= t('userDetail') %></h1>
<%- include('_tabs', { tab: 'users' }) %>

<div class="job-card">
  <div class="profile-head">
    <% if (user.avatar_url) { %>
      <img class="avatar-lg" src="<%= user.avatar_url %>" alt="<%= user.name %>">
    <% } else { %>
      <div class="avatar-lg avatar-ph"><%- icon('users') %></div>
    <% } %>
    <div>
      <h2 style="margin:0 0 6px"><%= user.name %></h2>
      <span class="pill <%= user.role==='admin'?'bad':(user.role==='company'?'warn':'ok') %>"><%= user.role %></span>
      <% if (user.google_id) { %><span class="pill ok" style="margin-left:6px"><span class="g-logo">G</span> <%= t('googleLinked') %></span><% } %>
    </div>
  </div>

  <table class="data kv" style="margin-top:14px">
    <tr><th><%= t('phone') %></th><td><%= user.phone %></td></tr>
    <tr><th><%= t('email') %></th><td><%= user.email || '—' %></td></tr>
    <tr><th><%= t('createdAt') %></th><td><%= new Date(user.created_at).toLocaleString() %></td></tr>
  </table>

  <% if (user.role === 'freelancer' && profile) { %>
    <h3 style="margin-top:16px"><%= t('profile') %></h3>
     <table class="data kv">
      <tr><th><%= t('profession') %></th><td><%= profile.profession ? catName(profile.profession, lang) : '—' %></td></tr>
      <tr><th><%= t('skills') %></th><td><%= profile.skills || '—' %></td></tr>
      <tr><th><%= t('bio') %></th><td><%= profile.bio || '—' %></td></tr>
    </table>
  <% } %>
  <% if (user.role === 'company' && profile) { %>
    <h3 style="margin-top:16px"><%= t('companyProfile') %></h3>
     <table class="data kv">
      <tr><th><%= t('companyName') %></th><td><%= profile.company_name %></td></tr>
      <tr><th><%= t('licenseNo') %></th><td><%= profile.license_no || '—' %></td></tr>
      <tr><th><%= t('tin') %></th><td><%= profile.tin || '—' %></td></tr>
      <tr><th><%= t('verified') %></th><td><%= profile.verified ? t('approved') : t('pending') %> (<%= profile.verification_status %>)</td></tr>
    </table>
  <% } %>

  <h3 style="margin-top:16px"><%= t('dashboard') %></h3>
  <div class="stats-line">
    <% if (counts.applications !== undefined) { %><div class="stat"><span class="count"><%= counts.applications %></span><span><%= t('applications') %></span></div><% } %>
    <% if (counts.jobs !== undefined) { %><div class="stat"><span class="count"><%= counts.jobs %></span><span><%= t('jobsPosted') %></span></div><% } %>
    <% if (counts.applicationsReceived !== undefined) { %><div class="stat"><span class="count"><%= counts.applicationsReceived %></span><span><%= t('applied') %></span></div><% } %>
    <div class="stat"><span class="count"><%= counts.messagesSent %></span><span><%= t('messagesSent') %></span></div>
  </div>
  <div style="margin-top:12px"><a class="btn btn-outline btn-sm" href="/admin/users"><%= t('back') %></a></div>
</div>
