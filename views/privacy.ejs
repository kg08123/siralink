<div style="max-width:560px;margin:0 auto;padding:8px 0 24px">
  <div style="text-align:center;padding:24px 0 8px">
    <div class="logo-mark" style="width:64px;height:64px;font-size:32px;margin:0 auto 16px;display:flex;align-items:center;justify-content:center">S</div>
    <h1 class="page-title" style="margin-bottom:8px"><%= t('privacyTitle') %></h1>
    <p class="sub" style="font-size:1rem"><%= t('privacyIntro') %></p>
  </div>

  <% [[t('privacyCollectT'),t('privacyCollectB')],[t('privacyGoogleT'),t('privacyGoogleB')],[t('privacyUseT'),t('privacyUseB')],[t('privacyShareT'),t('privacyShareB')],[t('privacyControlT'),t('privacyControlB')]].forEach(function(s){ %>
    <div class="section">
      <h2><%= s[0] %></h2>
      <p style="margin:0"><%= s[1] %></p>
    </div>
  <% }) %>

  <a class="btn btn-green" style="width:100%;margin-bottom:10px" href="/support"><%= t('aboutSupportCta') %></a>
  <a class="btn btn-outline" style="width:100%" href="/"><%= t('wBrowseJobs') %></a>
</div>
