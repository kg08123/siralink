<h1 class="page-title"><%= t('supportChat') %></h1>
<p class="sub"><%= t('supportIntro') %></p>
<div class="chat" id="chat">
  <% messages.forEach(function(m){ %>
    <div class="bubble <%= m.sender==='user'?'mine':'theirs' %>">
      <p><%= m.body %></p>
      <small><%= new Date(m.created_at).toLocaleString() %></small>
    </div>
  <% }) %>
</div>
<form method="post" action="/support" class="chatbar">
  <input type="text" name="body" placeholder="<%= t('typeMessage') %>" autocomplete="off" maxlength="2000" required>
  <button class="icon-btn" type="submit" aria-label="<%= t('send') %>"><%- icon('send') %></button>
</form>
<script>
(function(){ var c=document.getElementById('chat'); c.scrollTop=c.scrollHeight; })();
</script>
