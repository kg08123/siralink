<h1 class="page-title"><%= t('dashboard') %></h1>
<p class="sub"><%= user.name %> · <%= catName(profile.profession, lang) %></p>
<% if (user.email && !user.email_verified) { %>
  <div class="chat-item" style="cursor:default;margin-bottom:12px">
    <div class="grow"><div class="sub">✉️ <%= t('verifyEmailPrompt') %></div></div>
    <form method="post" action="/resend-verification" style="flex:0 0 auto">
      <button class="btn btn-amber btn-sm" type="submit"><%= t('resendVerification') %></button>
    </form>
  </div>
<% } %>

<div class="stat4">
  <div class="box"><b><%= counts.total %></b><small><%= t('myApplications') %></small></div>
  <div class="box"><b><%= counts.pending %></b><small><%= t('pending') %></small></div>
</div>

<div class="tabs">
  <a href="/f/applications"><%= t('myApplications') %></a>
  <a href="/f/profile"><%= t('profile') %></a>
  <a href="/"><%= t('findJobs') %></a>
</div>

<h3><%= t('myApplications') %></h3>
<% if (!apps.length) { %><div class="empty"><%= t('noApplications') %></div><% } %>
<% apps.forEach(function(a){ %>
  <div class="job-card">
    <h3><%= a.title %></h3>
    <div class="co-line"><span><%= a.company_name %></span></div>
    <span class="pill <%= a.status==='accepted'?'ok':(a.status==='rejected'?'bad':'wait') %>"><%= t(a.status) %></span>
  </div>
<% }) %>
