<h1 class="page-title"><%= t('applyUnlockTitle') %></h1>
<p class="sub"><%= t('applyUnlockBody').replace('{fee}', String(fee)) %></p>

<div class="section">
  <h2><%= t('applyUnlockFee') %> — <span style="color:var(--amber)"><%= fee.toLocaleString('en-US') %> ETB</span></h2>
  <p><%= t('payInstruction') %></p>
  <div class="copy-row"><span id="tbnum"><%= telebirr %></span>
    <button type="button" class="btn btn-amber btn-sm" onclick="copyNum('tbnum')"><%= t('copyNumber') %></button>
  </div>
</div>

<div class="section">
  <h2><%= t('uploadReceipt') %></h2>
  <% if (payment && payment.status) { %>
    <p><span class="pill <%= payment.status==='approved'?'ok':(payment.status==='rejected'?'bad':'warn') %>"><%= t(payment.status) %></span></p>
  <% } %>
  <form method="post" action="/f/apply-payment" enctype="multipart/form-data">
    <label class="upload-zone">
      <div style="font-size:2rem">📤</div>
      <div style="font-weight:700"><%= t('uploadReceipt') %></div>
      <input type="file" name="receipt" accept="image/*" required onchange="this.form.querySelector('.fname').textContent=this.files[0].name">
      <div class="fname hint"></div>
    </label>
    <p class="hint" style="margin-top:10px">⏳ <%= t('approvalNote') %></p>
    <button class="btn btn-green" type="submit" style="margin-top:8px"><%= t('submitForApproval') %></button>
  </form>
</div>
