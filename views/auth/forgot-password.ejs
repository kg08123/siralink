<h1 class="page-title" style="text-align:center"><%= t('forgotPassword') %></h1>
<p class="sub" style="text-align:center"><%= t('forgotPasswordSub') %></p>

<form method="post" action="/forgot-password">
  <div class="field">
    <label><%= t('email') %></label>
    <input type="email" name="email" placeholder="you@example.com" required>
  </div>
  <button class="btn btn-green" type="submit"><%= t('sendResetLink') %></button>
</form>
<p class="sub" style="text-align:center;margin-top:14px"><a href="/signin" style="color:var(--green);font-weight:700"><%= t('backToSignIn') %></a></p>
