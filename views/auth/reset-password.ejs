<h1 class="page-title" style="text-align:center"><%= t('resetPassword') %></h1>
<p class="sub" style="text-align:center"><%= t('resetPasswordSub') %></p>

<form method="post" action="/reset-password/<%= token %>">
  <div class="field">
    <label><%= t('newPassword') %> *</label>
    <input type="password" name="password" required minlength="4">
  </div>
  <div class="field">
    <label><%= t('confirmPassword') %> *</label>
    <input type="password" name="password2" required minlength="4">
  </div>
  <button class="btn btn-green" type="submit"><%= t('resetPassword') %></button>
</form>
