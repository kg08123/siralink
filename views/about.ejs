<div style="max-width:560px;margin:0 auto;padding:8px 0 24px">
  <div style="text-align:center;padding:24px 0 8px">
    <div class="logo-mark" style="width:64px;height:64px;font-size:32px;margin:0 auto 16px;display:flex;align-items:center;justify-content:center">S</div>
    <h1 class="page-title" style="margin-bottom:8px"><%= t('aboutTitle') %></h1>
    <p class="sub" style="font-size:1rem"><%= t('aboutIntro') %></p>
  </div>

  <div class="section">
    <h2><%= t('aboutHowTitle') %></h2>
    <% [[t('aboutStep1T'),t('aboutStep1D')],[t('aboutStep2T'),t('aboutStep2D')],[t('aboutStep3T'),t('aboutStep3D')],[t('aboutStep4T'),t('aboutStep4D')]].forEach(function(s,i){ %>
      <div style="display:flex;gap:12px;align-items:flex-start;padding:10px 0;border-bottom:1px solid var(--line)">
        <div class="logo-mark" style="width:32px;height:32px;font-size:15px;flex:0 0 auto"><%= i+1 %></div>
        <div>
          <b><%= s[0] %></b>
          <div class="sub" style="margin:2px 0 0"><%= s[1] %></div>
        </div>
      </div>
    <% }) %>
  </div>

  <div class="section" style="background:var(--green-soft);border:1px solid #cfe8d8">
    <h2><%= t('aboutFreeTitle') %></h2>
    <p style="margin:0"><%= t('aboutFreeBody') %></p>
  </div>

  <a class="btn btn-green" style="width:100%;margin-bottom:10px" href="/support"><%= t('aboutSupportCta') %></a>
  <a class="btn btn-outline" style="width:100%" href="/"><%= t('wBrowseJobs') %></a>
</div>
