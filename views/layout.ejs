<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>SiraLink — <%= typeof title !== 'undefined' ? title : t('appTag') %></title>
<link rel="stylesheet" href="/css/style.css">
</head>
<body>
<header class="topbar">
  <div class="topbar-in">
    <a class="logo" href="/"><span class="logo-mark">S</span>SiraLink</a>
    <nav class="navlinks">
      <% if (user) { %>
        <a class="msg-ico" href="/messages" aria-label="<%= t('messages') %>"><%- icon('comment') %><% if (unreadCount > 0) { %><span class="badge"><%= unreadCount > 99 ? '99+' : unreadCount %></span><% } %></a>
        <button class="hamb" id="menuBtn" aria-label="menu"><%- icon('menu') %></button>
      <% } else { %>
        <a class="btn-signin" href="/signin"><%= t('signIn') %></a>
      <% } %>
      <span class="lang-toggle">
        <a href="?lang=en" class="<%= lang==='en'?'on':'' %>">EN</a><a href="?lang=am" class="<%= lang==='am'?'on':'' %>">አማ</a>
      </span>
    </nav>
  </div>
</header>
<% if (user) { %>
<div class="drawer-backdrop" id="drawerBackdrop" hidden></div>
<aside class="drawer" id="drawer" aria-label="menu">
  <div class="drawer-head">
    <div class="drawer-avatar"><%= user.name ? user.name.trim()[0].toUpperCase() : 'S' %></div>
    <div class="grow">
      <b><%= user.name %></b>
      <span class="sub" style="margin:0"><%= user.role === 'freelancer' ? t('freelancer') : user.role === 'company' ? t('company') : t('admin') %></span>
    </div>
    <button class="icon-btn drawer-close" id="drawerClose" aria-label="close"><%- icon('x') %></button>
  </div>
  <nav class="drawer-nav">
    <% if (user.role === 'freelancer') { %>
      <a href="/f/dashboard"><%- icon('grid') %><%= t('dashboard') %></a>
      <a href="/f/applications"><%- icon('file') %><%= t('myApplications') %></a>
    <% } else if (user.role === 'company') { %>
      <a href="/c/dashboard"><%- icon('grid') %><%= t('dashboard') %></a>
      <a href="/c/jobs"><%- icon('file') %><%= t('myJobs') %></a>
      <a href="/c/post"><%- icon('send') %><%= t('postJob') %></a>
    <% } else { %>
      <a href="/admin"><%- icon('grid') %><%= t('adminPanel') %></a>
    <% } %>
    <a href="/messages"><%- icon('comment') %><%= t('messages') %></a>
    <a href="/support"><%- icon('help') %><%= t('support') %></a>
    <a href="/settings"><%- icon('settings') %><%= t('settings') %></a>
    <a href="/about"><%- icon('info') %><%= t('aboutUs') %></a>
    <a href="/signout" class="danger"><%- icon('logout') %><%= t('signOut') %></a>
  </nav>
</aside>
<% } %>
<main class="wrap">
  <% if (flash) { %><div class="flash <%= flash.type %>"><%= flash.msg %></div><% } %>
  <%- body %>
</main>
<footer class="footer">SiraLink · <%= t('appTag') %> · Addis Ababa, Ethiopia<br><a href="/about"><%= t('aboutUs') %></a> · <a href="/support"><%= t('support') %></a></footer>
<script>
function copyNum(id){const el=document.getElementById(id);if(!el)return;navigator.clipboard&&navigator.clipboard.writeText(el.innerText.trim());}
// Slide-in drawer menu
(function(){
  var b=document.getElementById('menuBtn'), d=document.getElementById('drawer'),
      bg=document.getElementById('drawerBackdrop'), x=document.getElementById('drawerClose');
  if(!b||!d) return;
  function open(){ d.classList.add('open'); bg.hidden=false; document.body.style.overflow='hidden'; }
  function close(){ d.classList.remove('open'); bg.hidden=true; document.body.style.overflow=''; }
  b.addEventListener('click', function(e){ e.stopPropagation(); open(); });
  if(x) x.addEventListener('click', close);
  if(bg) bg.addEventListener('click', close);
  document.addEventListener('keydown', function(e){ if(e.key==='Escape') close(); });
})();
// Like button toggle (no page reload)
document.addEventListener('click', async function(e){
  var btn=e.target.closest('.like-btn');
  if(!btn || btn.tagName==='A') return;
  e.preventDefault(); e.stopPropagation();
  try{
    var r=await fetch('/jobs/'+btn.dataset.job+'/like',{method:'POST',headers:{'Accept':'application/json'}});
    if(r.redirected || r.url.indexOf('/signin')!==-1){ window.location.href='/signin'; return; }
    if(!r.ok) return;
    var data=await r.json();
    btn.classList.toggle('liked', !!data.liked);
    var c=btn.querySelector('.like-count'); if(c) c.textContent=data.count;
  }catch(err){}
});
</script>
</body>
</html>
