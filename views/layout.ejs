<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>SiraLink — <%= typeof title !== 'undefined' ? title : t('appTag') %></title>
<link rel="stylesheet" href="/css/style.css">
</head>
<body>
<header class="topbar">
  <div class="topbar-in">
    <a class="logo" href="/"><span class="logo-mark">S</span>SiraLink</a>
    <nav class="navlinks">
      <% if (user) { %>
        <a class="msg-ico" href="/notifications" aria-label="<%= t('notifications') %>"><%- icon('bell') %><% if (notifCount > 0) { %><span class="badge"><%= notifCount > 99 ? '99+' : notifCount %></span><% } %></a>
        <a class="msg-ico" href="/messages" aria-label="<%= t('messages') %>"><%- icon('comment') %><% if (unreadCount > 0) { %><span class="badge"><%= unreadCount > 99 ? '99+' : unreadCount %></span><% } %></a>
        <div class="menu-wrap">
          <button class="hamb" id="menuBtn" aria-label="menu" aria-haspopup="true"><%- icon('menu') %></button>
          <div class="menu-drop" id="menuDrop" hidden>
            <% if (user.role === 'freelancer') { %>
              <a href="/f/dashboard"><%= t('dashboard') %></a>
              <a href="/f/applications"><%= t('myApplications') %></a>
            <% } else if (user.role === 'company') { %>
              <a href="/c/dashboard"><%= t('dashboard') %></a>
              <a href="/c/jobs"><%= t('myJobs') %></a>
              <a href="/c/post"><%= t('postJob') %></a>
            <% } %>
            <a href="/signout"><%= t('signOut') %></a>
          </div>
        </div>
      <% } else { %>
        <a class="btn-signin" href="/signin"><%= t('signIn') %></a>
      <% } %>
      <span class="lang-toggle">
        <a href="?lang=en" class="<%= lang==='en'?'on':'' %>">EN</a><a href="?lang=am" class="<%= lang==='am'?'on':'' %>">አማ</a>
      </span>
    </nav>
  </div>
</header>
<main class="wrap">
  <% if (flash) { %><div class="flash <%= flash.type %>"><%= flash.msg %></div><% } %>
  <%- body %>
</main>
<footer class="footer">SiraLink · <%= t('appTag') %> · Addis Ababa, Ethiopia</footer>
<script>
function copyNum(id){const el=document.getElementById(id);if(!el)return;navigator.clipboard&&navigator.clipboard.writeText(el.innerText.trim());}
// Hamburger menu toggle
(function(){
  var b=document.getElementById('menuBtn'), d=document.getElementById('menuDrop');
  if(!b||!d) return;
  b.addEventListener('click', function(e){ e.stopPropagation(); d.hidden=!d.hidden; });
  document.addEventListener('click', function(e){ if(!d.hidden && !d.contains(e.target)) d.hidden=true; });
})();
// Like button toggle (no page reload)
document.addEventListener('click', async function(e){
  var btn=e.target.closest('.like-btn');
  if(!btn || btn.tagName==='A') return;
  e.preventDefault(); e.stopPropagation();
  try{
    var r=await fetch('/jobs/'+btn.dataset.job+'/like',{method:'POST',headers:{'Accept':'application/json'}});
    if(r.redirected || r.url.indexOf('/signin')!==-1){ window.location.href='/signin'; return; }
    if(!r.ok) return;
    var data=await r.json();
    btn.classList.toggle('liked', !!data.liked);
    var c=btn.querySelector('.like-count'); if(c) c.textContent=data.count;
  }catch(err){}
});
</script>
</body>
</html>
