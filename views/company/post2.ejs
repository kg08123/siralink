<h1 class="page-title"><%= t('payment') %></h1>
<p class="sub"><%= t('step2') %> — <%= job.title %></p>
<div class="stepbar"><i style="width:100%"></i></div>

<div class="section">
  <h2><%= t('jobPostFee') %> — <span style="color:var(--amber)"><%= fee.toLocaleString('en-US') %> ETB</span></h2>
  <p><%= t('payInstruction') %></p>
  <div class="copy-row"><span id="tbnum"><%= telebirr %></span>
    <button type="button" class="btn btn-amber btn-sm" onclick="copyNum('tbnum')"><%= t('copyNumber') %></button>
  </div>
</div>

<div class="section">
  <h2><%= t('uploadReceipt') %></h2>
  <% if (payment && payment.status) { %>
    <p><span class="pill <%= payment.status==='approved'?'ok':(payment.status==='rejected'?'bad':'warn') %>"><%= t(payment.status) %></span></p>
  <% } %>
  <form method="post" action="/c/post/payment/<%= job.id %>" enctype="multipart/form-data">
    <label class="upload-zone">
      <div style="font-size:2rem">📤</div>
      <div style="font-weight:700"><%= t('uploadReceipt') %></div>
      <input type="file" name="receipt" accept="image/*" required onchange="previewReceipt(this)">
      <div class="fname hint"></div>
      <img class="receipt-prev" hidden alt="">
    </label>
    <p class="hint" style="margin-top:10px">⏳ <%= t('approvalNote') %></p>
    <button class="btn btn-green" type="submit" style="margin-top:8px"><%= t('submitForApproval') %></button>
  </form>
</div>
<script>
function previewReceipt(input){
  var f=input.files[0]; if(!f) return;
  var form=input.form;
  var nameEl=form.querySelector('.fname'); if(nameEl) nameEl.textContent=f.name;
  var img=form.querySelector('.receipt-prev'); if(!img) return;
  var reader=new FileReader();
  reader.onload=function(e){ img.src=e.target.result; img.hidden=false; };
  reader.readAsDataURL(f);
}
</script>
